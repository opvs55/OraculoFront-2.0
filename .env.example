# Analytics (PostHog) — opcional. Sem essas variáveis, o app funciona
# normalmente e o rastreamento fica desligado (no-op).
# Chave do projeto em PostHog > Project Settings > Project API Key.
VITE_POSTHOG_KEY=
# Host da região do seu projeto: https://us.i.posthog.com ou https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
